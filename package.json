{
  "name": "@phis/server",
  "version": "0.2.16",
  "license": "Apache-2.0",
  "description": "The phis control plane: the server that answers for Sites, Spaces, media, authorization, translations and Add-ons, and the phis operator CLI that installs, configures and migrates an installation.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phis-dev/phis-server.git"
  },
  "homepage": "https://github.com/phis-dev/phis-server#readme",
  "bugs": {
    "url": "https://github.com/phis-dev/phis-server/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "private": true,
  "engines": {
    "node": ">=24.21.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.21.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "build:cli": "node scripts/build-cli.mjs",
    "package:dist": "node scripts/prepare-package-dist.mjs && node scripts/validate-package-dist.mjs",
    "package:pack": "pnpm build && pnpm build:cli && pnpm package:dist && pnpm --dir package pack --pack-destination ..",
    "auth:config-keys": "node scripts/validate-auth-installation-config-keys.mjs",
    "db:boundary": "node scripts/validate-db-sql-boundary.mjs",
    "docs:api": "node scripts/generate-api-reference.mjs",
    "docs:api:check": "node scripts/generate-api-reference.mjs --check",
    "licenses:check": "pnpm phis licenses check",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:pg": "PHIS_PG_TEST=1 vitest run --config vitest.pg.config.ts",
    "phis": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types ./src/cli/phis.mts",
    "phis:dist": "node ./dist/phis.mjs"
  },
  "dependencies": {
    "@phis/contracts": "^0.7.6",
    "argon2": "^0.45.1",
    "harfbuzzjs": "^1.6.1",
    "next": "^16.4.2",
    "nodemailer": "^9.0.3",
    "openid-client": "^6.8.8",
    "pg": "^8.23.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanitize-html": "2.17.7",
    "sharp": "^0.35.4",
    "wawoff2": "^2.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "2.16.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "babel-plugin-react-compiler": "1.0.0",
    "esbuild": "0.28.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "3.2.4"
  },
  "bin": {
    "phis": "./dist/phis.mjs"
  }
}
