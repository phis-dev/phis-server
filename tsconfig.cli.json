{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "./src",
    "outDir": "./dist",
    "noEmit": false,
    "declaration": false,
    "incremental": false,
    "sourceMap": false,
    "isolatedModules": false,
    "jsx": "preserve",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "paths": {}
  },
  "include": [
    "src/cli/**/*.mts",
    "src/db/**/*.mts",
    "src/lib/addons/contract.ts",
    "src/lib/addons/core-capabilities.ts",
    "src/lib/addons/manifest.ts",
    "src/lib/constants/server-addons.ts",
    "src/lib/config-files-cli.ts",
    "src/lib/config-core.ts",
    "src/lib/password-core.ts"
  ],
  "exclude": ["node_modules", ".next", "dist"]
}
