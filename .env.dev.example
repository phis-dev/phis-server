# Copy to .env.dev for local development.
# Keep real secrets out of git.

# Runtime secrets and service config now live in config/phis-runtime.json.
# How many reverse proxies in front of this process are ours: "true"/unset is one, "false"/"0" none,
# a number that many. It picks which X-Forwarded-For entry is believed -- proxies append rather than
# replace, so the leftmost entry is the caller's own to write. Behind a CDN in front of nginx: 2.
# See README.md, "Process variables".
TRUST_PROXY=true
PORT=3000
# The interface to bind. Leave it on loopback wherever a reverse proxy is what the outside reaches.
# Read by `next start` and the standalone server -- HOSTNAME, not HOST. `next dev` reads neither and
# takes the flag instead: `pnpm dev -H 127.0.0.1`.
HOSTNAME=127.0.0.1
