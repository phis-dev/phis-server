          {
            "id": "offerings.mine",
            "method": "GET",
            "path": "offerings",
            "handler": "listMine",
            "auth": "site-user",
            "siteScoped": true
          },
          {
            "id": "offerings.add",
            "method": "POST",
            "path": "offerings",
            "handler": "addOffering",
            "auth": "site-user",
            "siteScoped": true,
            "bodyLimitBytes": 65536
