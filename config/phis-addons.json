            "id": "offerings.status",
            "method": "POST",
            "path": "offerings/:id/status",
            "handler": "setOfferingStatus",
            "auth": "site-user",
            "siteScoped": true,
            "bodyLimitBytes": 4096
          },
          {
            "id": "offerings.drop",
            "method": "DELETE",
            "path": "offerings/:id",
            "handler": "dropOffering",
            "auth": "site-user",
            "siteScoped": true
