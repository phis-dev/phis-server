# Copy this template to /srv/phis/stages/<stage>/.env and adjust the values.

PORT=5301
HOSTNAME=127.0.0.1

# Server Actions encrypt their bound arguments with a key that "next build" bakes
# into the artifact, so every installation of the same package would share it.
# The package generates one per stage on first install; set it by hand only when
# migrating a stage or when several hosts serve one installation, in which case
# all of them need the same value.
#
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=<head -c 32 /dev/urandom | base64>
