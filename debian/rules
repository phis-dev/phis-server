#!/usr/bin/make -f
ARTIFACT_DIR ?= ..

# What this build is, for the runtime to report as its release. The commit is what identifies a build
# across the stages that run it; the changelog version stands in where the package is built from an
# exported source tree with no git history, so the field is never empty and never invented.
PHIS_RELEASE_ID ?= $(shell git rev-parse --short=12 HEAD 2>/dev/null || dpkg-parsechangelog -SVersion)

%:
	dh $@

override_dh_auto_configure:
	npm ci

override_dh_auto_build:
	npm run build
	npm run build:cli

override_dh_auto_install:
	install -d debian/phis/usr/lib/phis
	install -d debian/phis/usr/lib/phis/.next
	cp -a .next/standalone/. debian/phis/usr/lib/phis/
	cp -a .next/static debian/phis/usr/lib/phis/.next/
	find debian/phis/usr/lib/phis/node_modules -type d \( -name '*linuxmusl*' -o -name '*musl*' \) -prune -exec rm -rf {} +
	find debian/phis/usr/lib/phis/node_modules/argon2/prebuilds -type f -name '*.musl.node' -delete
	cd debian/phis/usr/lib/phis/node_modules && \
		argon2_target=$$(printf '%s\n' .pnpm/argon2@*/node_modules/argon2) && \
		ln -s "$$argon2_target" argon2 && \
		pg_target=$$(printf '%s\n' .pnpm/pg@*/node_modules/pg) && \
		ln -s "$$pg_target" pg
	install -d debian/phis/usr/share/phis
	printf '# Written by debian/rules at package build time. Do not edit.\nPHIS_RELEASE_ID=%s\n' \
		'$(PHIS_RELEASE_ID)' > debian/phis/usr/share/phis/release.env

override_dh_auto_test:
	:

override_dh_auto_clean:
	rm -rf .next dist
	dh_auto_clean

override_dh_installsystemd:
	dh_installsystemd --no-enable --no-start

override_dh_builddeb:
	dh_builddeb --destdir=$(ARTIFACT_DIR)
